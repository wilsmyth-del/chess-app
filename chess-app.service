[Unit]
Description=Chess App (Gunicorn + Stockfish)
After=network.target

[Service]
Type=simple
User=wil
WorkingDirectory=/home/wil/dev/chess-app
ExecStart=/home/wil/dev/chess-app/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 "server:create_app()"
Restart=on-failure
RestartSec=5
Environment=STOCKFISH_PATH=/home/wil/dev/chess-app/stockfish/stockfish-ubuntu-x86-64-avx2

[Install]
WantedBy=multi-user.target
